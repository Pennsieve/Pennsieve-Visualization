{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    // Declaration maps point at sources this package does not publish, so they
    // would only give consumers broken jump-to-definition targets.
    "declarationMap": false,
    "noEmit": false,
    // The tests read fixtures with node:fs. Named here, not left to arrive through a
    // dependency's own types the way they once did through Amplify's.
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
