{
  "name": "@pennsieve-viz/tsviewer",
  "version": "1.4.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@pennsieve/timeseries-zarr-reader": "0.4.0",
    "protobufjs": "^7.6.3",
    "tiny-emitter": "2.1.0"
  },
  "devDependencies": {
    "@aws-amplify/auth": "^6.13.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "element-plus": "^2.10.2",
    "pinia": "^3.0.3",
    "sass": "^1.88.0",
    "unplugin-auto-import": "19.3.0",
    "unplugin-vue-components": "28.7.0",
    "vite": "^6.2.4",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.17"
  },
  "peerDependencies": {
    "@aws-amplify/auth": "^6.0.0",
    "element-plus": "^2.3.0",
    "pinia": "^2.0.0 || ^3.0.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@aws-amplify/auth": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pennsieve/pennsieve-visualization.git",
    "directory": "packages/ts-viewer"
  }
}
