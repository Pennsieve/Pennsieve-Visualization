{
  "name": "pennsieve-viz-monorepo",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/serve-test-zarr.py & node scripts/serve-timeseries-zarr.mjs & pnpm --filter @pennsieve-viz/core dev & pnpm --filter @pennsieve-viz/orthogonal dev:embed",
    "dev:embed": "pnpm --filter @pennsieve-viz/orthogonal dev:embed",
    "dev:ts-zarr": "node scripts/serve-timeseries-zarr.mjs",
    "dev:tsviewer-watch": "pnpm --filter @pennsieve-viz/tsviewer exec vite build --watch",
    "test": "pnpm --filter @pennsieve-viz/tsviewer test",
    "build": "pnpm --filter @pennsieve-viz/micro-ct build && pnpm --filter @pennsieve-viz/tsviewer build && pnpm --filter @pennsieve-viz/core build",
    "build:core": "pnpm --filter @pennsieve-viz/core build",
    "build:tsviewer": "pnpm --filter @pennsieve-viz/tsviewer build",
    "build:micro-ct": "pnpm --filter @pennsieve-viz/micro-ct build",
    "build:orthogonal": "pnpm --filter @pennsieve-viz/orthogonal build",
    "build:orthogonal-embed": "pnpm --filter @pennsieve-viz/orthogonal build:embed",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r exec rm -rf dist",
    "lint": "eslint packages",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@aws-amplify/auth": "^6.13.0",
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.26.0",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/ramda": "^0.30.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "pinia": "^3.0.3",
    "sass-embedded": "^1.90.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.17",
    "vue-tsc": "^3.0.3"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.2"
}
